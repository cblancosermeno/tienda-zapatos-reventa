VITE_API_URL=http://localhost:4000/api

# Id del revendedor (fila en la tabla "revendedores" del backend) cuyo
# WhatsApp, teléfono de llamada y recargo debe mostrar este despliegue.
# Se crea/edita desde el admin, pantalla "Revendedores". Si se deja vacío,
# el sitio usa valores de respaldo fijos (ver src/context/RevendedorContext.jsx).
VITE_REVENDEDOR_ID=

# Opcional: ID de medición de Google Analytics (GA4), formato G-XXXXXXXXXX.
# Se crea gratis en https://analytics.google.com. Si se deja vacío, el
# sitio no envía datos a Google Analytics.
VITE_GA_MEASUREMENT_ID=
